-- `drt p2p --match`: the reference signalling server for
-- doc/DRT-Signalling.md (doc/P2P.md §2.4), grown from
-- examples/30-signaling-room with what the example leaves out: names
-- claimed on first use, a caller token and an admission range set by the
-- answerer when it claims, and a cap on names held at once. The example
-- stays its readable core; this is the whole server.
--
-- ## surface block
--
-- - Entry point: the verb runs it with an http listener on --host:<port>,
--   `args.capacity` the names held at once.
-- - Configurable: HOLD_MS (§3), PRESENT_MS (§4.2), WAITING_CAP (§6),
--   RECORD_MAX (§1), KEEPALIVE_MS (§5), the CORS headers.
-- - Fan-out: `routes`, the five requests of §2 and the two of §6.2
--   (pairing), each with whose token it takes; `claim`, how a name is held;
--   `kv_route`, the kv requests (doc/DRT-Signalling.md §10), one call from
--   `route`, and `kv_access`, the one place a kv request is admitted.
-- - kv (only with `args.kv`, the database `drt p2p --match --kv <dir>`
--   names): KV_VALUE_MAX, KV_KEY_MAX, KV_TOPIC_MAX, KV_LIST_DEFAULT,
--   KV_LIST_MAX, KV_TTL_MAX, KV_EVENTS_KEPT, KV_POLL_MS.
--
-- Admission is by token, not origin: every reply carries
-- access-control-allow-origin: *, so a page opened from file:// (Origin:
-- null) reaches a named peer as a page served from anywhere does.

local HOLD_MS      = 25000
local PRESENT_MS   = 30000
local WAITING_CAP  = 16
local RECORD_MAX   = 512
local KEEPALIVE_MS = 25000
-- kv: values are small text, not files; a listing is a page, not a dump.
local KV_VALUE_MAX    = 16384
local KV_KEY_MAX      = 256
local KV_TOPIC_MAX    = 64
local KV_LIST_DEFAULT = 100
local KV_LIST_MAX     = 1000
local KV_TTL_MAX      = 31536000   -- a year, in seconds
local KV_EVENTS_KEPT  = 1024       -- changes a watcher can resume across
local KV_POLL_MS      = 25000      -- inside the listener's 30 s deadline
local CORS = {
  ['access-control-allow-origin']   = '*',
  ['access-control-allow-methods']  = 'GET, PUT, POST, DELETE, OPTIONS',
  ['access-control-allow-headers']  = 'authorization, content-type, last-event-id, drt-accept, drt-caller-token, if-match, if-none-match',
  ['access-control-expose-headers'] = 'location, retry-after, etag',
}

local requests = queue.declare('http_in', {capacity = 64})
local replies  = queue.declare('http_out', {capacity = 128, exported = true})
local _, args  = queue.wait({queue.declare('args', {capacity = 1})})
local CAPACITY = tonumber(args.capacity) or 256
local KV_DB    = args.kv   -- a database name inside the sql scope, or nil: no kv

-- depth: replies

local function with(extra)
  local h = {}
  for k, v in pairs(CORS) do h[k] = v end
  for k, v in pairs(extra or {}) do h[k] = v end
  return h
end

-- `json` is the reply; the encoder is Diluvium's `json` module under another name.
local json_text = json.encode
-- A body read as JSON, or nil: a body that is not JSON is not a request.
local function json_body(text)
  if text == '' then return nil end
  local ok, v = pcall(json.decode, text)
  return ok and v or nil
end

local function json(conn, status, body, extra)
  queue.push(replies, {conn = conn, status = status, body = body,
                       content_type = 'application/json', headers = with(extra)})
end

local function fail(conn, status, why, extra) json(conn, status, json_text({error = why}), extra) end

-- '/v1/page/calls?since=3&k=t' -> '/v1/page/calls', {since = '3', k = 't'}
local function split(target)
  local path, query = target:match('^([^?]*)%??(.*)$')
  local params = {}
  for k, v in query:gmatch('([^&=]+)=([^&]*)') do params[k] = v end
  return path, params
end

-- depth: addresses, for DRT-Accept

-- An IPv4 or IPv6 address as a list of 8-bit numbers, or nil.
local function address_bytes(text)
  local a, b, c, d = text:match('^(%d+)%.(%d+)%.(%d+)%.(%d+)$')
  if a then
    local out = {}
    for _, v in ipairs({a, b, c, d}) do
      v = tonumber(v); if v > 255 then return nil end
      out[#out + 1] = v
    end
    return out
  end
  if not text:find(':') then return nil end
  -- IPv6: expand `::`, each group two bytes.
  local head, tail = text:match('^(.-)::(.*)$')
  local groups = {}
  local function take(part, into)
    if part == '' then return true end
    for g in part:gmatch('[^:]+') do
      if not g:match('^%x%x?%x?%x?$') then return false end
      into[#into + 1] = tonumber(g, 16)
    end
    return true
  end
  if head then
    local h, t = {}, {}
    if not take(head, h) or not take(tail, t) then return nil end
    if #h + #t > 7 then return nil end
    for _, g in ipairs(h) do groups[#groups + 1] = g end
    for _ = 1, 8 - #h - #t do groups[#groups + 1] = 0 end
    for _, g in ipairs(t) do groups[#groups + 1] = g end
  else
    if not take(text, groups) or #groups ~= 8 then return nil end
  end
  local out = {}
  for _, g in ipairs(groups) do out[#out + 1] = g // 256; out[#out + 1] = g % 256 end
  return out
end

-- The address half of a listener's `peer` (`ip:port`, `[ip]:port`).
local function address_of(peer)
  if not peer then return nil end
  local v6 = peer:match('^%[(.-)%]:%d+$')
  if v6 then return v6 end
  local v4 = peer:match('^([%d%.]+):%d+$')
  return v4 or peer
end

-- Whether `ip` is inside one of the ranges in a DRT-Accept value,
-- `cidr, cidr`; a bare address is a /32 or /128. Unreadable ranges admit
-- nothing, so a typo refuses rather than opens.
local function accepted(ranges, ip)
  local addr = address_bytes(ip)
  if not addr then return false end
  for range in ranges:gmatch('[^,%s]+') do
    local net, bits = range:match('^(.-)/(%d+)$')
    if not net then net, bits = range, #addr * 8 end
    local base = address_bytes(net)
    bits = tonumber(bits)
    if base and #base == #addr and bits <= #addr * 8 then
      local ok, left = true, bits
      for i = 1, #addr do
        if left <= 0 then break end
        local keep = left >= 8 and 8 or left
        local shift = 2 ^ (8 - keep)
        if addr[i] // shift ~= base[i] // shift then ok = false; break end
        left = left - 8
      end
      if ok then return true end
    end
  end
  return false
end

local function token_of(m, params)
  local bearer = m.headers and m.headers.authorization
    and m.headers.authorization:match('^Bearer%s+(%S+)$')
  return bearer or params.k
end

-- depth: names, claimed on first use

local names = {}   -- name -> {token, caller, accept, polled, streams, calls, last}
local function held_count()
  local n = 0
  for _ in pairs(names) do n = n + 1 end
  return n
end

local function present(r, now)
  return (r.polled and now - r.polled < PRESENT_MS) or next(r.streams) ~= nil
end

-- The answerer's claim: a free name is taken by the first answerer token to
-- poll it, held while that token is present, and shared by every holder of
-- the same token. A name past the cap is 429; another token's name is 403.
-- Returns the name's record, or nil after replying.
local function claim(m, name, token, now)
  local r = names[name]
  if r and not present(r, now) then names[name] = nil; r = nil end
  if r and r.token ~= token then fail(m.conn, 403, 'this name is held by another answerer'); return nil end
  if not r then
    if held_count() >= CAPACITY then
      fail(m.conn, 429, 'no room for another name', {['retry-after'] = '30'}); return nil
    end
    r = {token = token, streams = {}, calls = {}, pairs = {}, last = 0}
    names[name] = r
  end
  local h = m.headers or {}
  if h['drt-caller-token'] then r.caller = h['drt-caller-token'] end
  if h['drt-accept'] then r.accept = h['drt-accept'] end
  return r
end

-- depth: the room, one per name

local function waiting(r)
  local count = 0
  for _, c in pairs(r.calls) do if not c.answered then count = count + 1 end end
  return count
end

local function checked(m)
  if not utf8.len(m.body) then fail(m.conn, 400, 'a record is text'); return false end
  if #m.body > RECORD_MAX then fail(m.conn, 413, 'a record is at most 512 bytes'); return false end
  return true
end

local function find(r, id)
  local n = tonumber(id:match('^c(%d+)$') or '')
  return n, n and r.calls[n]
end

local function event(cursor, kind)
  return 'id: ' .. cursor .. '\nevent: ' .. (kind or 'call') .. '\ndata: {"cursor":"' .. cursor .. '"}\n\n'
end

local function notify(r, cursor, now, kind)
  for conn in pairs(r.streams) do
    queue.push(replies, {conn = conn, chunk = event(cursor, kind)}); r.streams[conn] = now
  end
end

-- The caller's one request (§3): held until answered, or refused now.
local function call(m, name, token, now)
  local r = names[name]
  if not r or not present(r, now) then return fail(m.conn, 503, 'no answerer is present') end
  if r.caller and token ~= r.caller then
    return fail(m.conn, token and 403 or 401, token and 'this token may not call' or 'this name takes a caller token')
  end
  -- The answerer's DRT-Accept (§6.1): a caller outside it is refused here,
  -- by the address the listener saw, as the parked side refuses its
  -- packets; a server that cannot see addresses leaves that to the peer.
  if r.accept and m.peer and not accepted(r.accept, address_of(m.peer)) then
    return fail(m.conn, 403, 'this address may not call')
  end
  if not checked(m) then return end
  if waiting(r) >= WAITING_CAP then return fail(m.conn, 429, 'too many calls waiting', {['retry-after'] = '5'}) end
  r.last = r.last + 1
  r.calls[r.last] = {record = m.body, conn = m.conn, ends = now + HOLD_MS}
  notify(r, r.last, now)
end

local function list(m, r, params, now)
  local since = params.since or '0'
  if not since:match('^%d+$') then return fail(m.conn, 400, 'a malformed cursor') end
  r.polled = now
  local out, pair = {}, {}
  for n = tonumber(since) + 1, r.last do
    local c = r.calls[n]
    if c and not c.answered then
      out[#out + 1] = {id = 'c' .. n, record = c.record, expires_in = math.ceil((c.ends - now) / 1000)}
    end
    local p = r.pairs[n]
    if p and not p.outcome then
      local e = {id = 'p' .. n, name = p.name, expires_in = math.ceil((p.ends - now) / 1000)}
      if p.token then e.token = p.token end
      pair[#pair + 1] = e
    end
  end
  -- An empty table encodes as an object, so an empty list is written out.
  json(m.conn, 200, '{"cursor":"' .. r.last .. '","calls":' .. (#out > 0 and json_text(out) or '[]')
    .. ',"pair":' .. (#pair > 0 and json_text(pair) or '[]') .. '}')
end

local function answer(m, r, id, base)
  local _, c = find(r, id)
  if not c then return fail(m.conn, 404, 'no such call') end
  if c.answered then return fail(m.conn, 409, 'the call was already answered') end
  if not checked(m) then return end
  c.answered = true
  json(c.conn, 200, m.body, {location = base .. id})
  json(m.conn, 204, '')
end

local function withdraw(m, r, id)
  local n, c = find(r, id)
  if not c then return fail(m.conn, 404, 'no such call') end
  if c.answered then return fail(m.conn, 409, 'the call was already answered') end
  fail(c.conn, 410, 'the call was withdrawn or refused')
  r.calls[n] = nil
  json(m.conn, 204, '')
end

-- depth: pairing (§6.2)

-- `POST /v1/<name>/pair {"name": other}`, with <name>'s answerer token: the
-- server tells `other` to call <name>, with <name>'s caller token. `other`
-- must be present. The entry shares the cursor with calls, so a poll by
-- cursor sees it once.
local function ask_pair(m, r, name, now)
  local body = json_body(m.body)
  local other = type(body) == 'table' and body.name
  if type(other) ~= 'string' or other == '' then return fail(m.conn, 400, 'the body names whom to tell: {"name": "…"}') end
  if other == name then return fail(m.conn, 400, 'a name does not call itself') end
  local o = names[other]
  if not o or not present(o, now) then return fail(m.conn, 503, 'no answerer is present under that name') end
  o.last = o.last + 1
  o.pairs[o.last] = {name = name, token = r.caller, ends = now + HOLD_MS, asked_by = name}
  notify(o, o.last, now, 'pair')
  json(m.conn, 202, '{"id":"p' .. o.last .. '"}')
end

-- `POST /v1/<name>/pair/<id>/result`, with <name>'s answerer token.
local function pair_result(m, r, id, now)
  local n = tonumber(id:match('^p(%d+)$') or '')
  local p = n and r.pairs[n]
  if not p or now >= p.ends then return fail(m.conn, 404, 'no such pairing') end
  local body = json_body(m.body)
  local outcome = type(body) == 'table' and body.outcome
  if outcome ~= 'connected' and outcome ~= 'refused' and outcome ~= 'unreachable' and outcome ~= 'declined' then
    return fail(m.conn, 400, 'outcome is connected, refused, unreachable or declined')
  end
  p.outcome = outcome
  -- One log line per result: a `why` is the told side's words, so control
  -- characters are dropped and the length bounded before it is printed.
  local why = type(body.why) == 'string' and body.why:gsub('[%c]', ' '):sub(1, 200) or ''
  print('p2p match: ' .. p.asked_by .. ' asked for a call from ' .. m.name .. ': ' .. outcome
    .. (why ~= '' and (' (' .. why .. ')') or ''))
  json(m.conn, 204, '')
end

local function events(m, r, now)
  queue.push(replies, {conn = m.conn, stream = true, body = 'retry: 2000\n\n',
                       content_type = 'text/event-stream', headers = with({['cache-control'] = 'no-cache'})})
  r.streams[m.conn] = now
  local seen = tonumber((m.headers or {})['last-event-id'] or '')
  if seen and seen < r.last then queue.push(replies, {conn = m.conn, chunk = event(r.last)}) end
end

-- depth: kv admission, the seam topics fills in

-- Whether this request may `op` ('read' or 'write') the kv of `topic`;
-- false after replying. Without topics there is no token to check: the
-- verb says so when kv is on, and --host is what narrows who reaches it.
local function kv_access(m, topic, op)
  return true
end

-- depth: kv storage, one SQLite database (doc/DRT-Signalling.md §10)

local kv = {db = nil, revision = 0, next_expiry = nil, events = {}, oldest = 1,
            streams = {}, polls = {}}

local function kv_open()
  kv.db = host.sql.open(KV_DB)
  kv.db.exec('create table if not exists kv (topic text not null, key text not null, '
    .. 'value text not null, version integer not null, expires integer not null default 0, '
    .. 'primary key (topic, key)) without rowid')
  kv.db.exec('create index if not exists kv_expires on kv (expires) where expires > 0')
  kv.db.exec('create table if not exists kv_meta (name text primary key, value integer not null)')
  -- The last KV_EVENTS_KEPT changes, so a watcher resumes across a restart.
  kv.db.exec('create table if not exists kv_events (revision integer primary key, topic text not null, '
    .. "key text not null, op text not null, version integer not null default 0, value text not null default '')")
  local r = kv.db.query("select value from kv_meta where name = 'revision'").rows[1]
  kv.revision = r and r[1] or 0
  kv.oldest = kv.revision + 1
  for _, e in ipairs(kv.db.query('select revision, topic, key, op, version, value from kv_events '
      .. 'order by revision').rows) do
    kv.events[e[1]] = {revision = e[1], topic = e[2], key = e[3], op = e[4], version = e[5], value = e[6]}
    if e[1] < kv.oldest then kv.oldest = e[1] end
  end
  local e = kv.db.query('select coalesce(min(expires), 0) from kv where expires > 0').rows[1][1]
  kv.next_expiry = e > 0 and e or nil
end

-- A key that has expired and not yet been swept is absent.
local function kv_row(topic, key, wall)
  local r = kv.db.query('select value, version, expires from kv where topic = ? and key = ?',
                        topic, key).rows[1]
  if not r or (r[3] > 0 and r[3] <= wall) then return nil end
  return {value = r[1], version = r[2], expires = r[3]}
end

-- One change, `e` = {topic, key, op, value?}: the row, the revision and the
-- change's event move together, or none of them does. Returns the event,
-- its revision (and a put's version) filled in.
local function kv_commit(e, statement, ...)
  local revision = kv.revision + 1
  e.revision = revision
  if e.op == 'put' then e.version = revision end
  kv.db.exec('begin')
  local ok, err = pcall(function(...)
    kv.db.exec(statement, ...)
    kv.db.exec("insert into kv_meta (name, value) values ('revision', ?) "
      .. 'on conflict (name) do update set value = excluded.value', revision)
    kv.db.exec('insert into kv_events (revision, topic, key, op, version, value) values (?, ?, ?, ?, ?, ?)',
      revision, e.topic, e.key, e.op, e.version or 0, e.value or '')
    kv.db.exec('delete from kv_events where revision <= ?', revision - KV_EVENTS_KEPT)
    kv.db.exec('commit')
  end, ...)
  if not ok then pcall(kv.db.exec, 'rollback'); error(err, 0) end
  kv.revision = revision
  kv.events[revision] = e
  while kv.revision - kv.oldest + 1 > KV_EVENTS_KEPT do
    kv.events[kv.oldest] = nil; kv.oldest = kv.oldest + 1
  end
  return e
end

-- depth: kv watchers, by stream and by held request

local function kv_event_json(e)
  local out = {revision = e.revision, op = e.op, key = e.key}
  if e.op == 'put' then out.version = e.version; out.value = e.value end
  return json_text(out)
end

local function kv_sse(e)
  return 'id: ' .. e.revision .. '\nevent: kv\ndata: ' .. kv_event_json(e) .. '\n\n'
end

local function kv_wants(w, e)
  return w.topic == e.topic and e.key:sub(1, #w.prefix) == w.prefix
end

-- The events after `since` that `w` wants, oldest first; nil when `since`
-- is older than what is kept, and the watcher must list again.
local function kv_since(w, since)
  if since + 1 < kv.oldest then return nil end
  local out = {}
  for n = since + 1, kv.revision do
    local e = kv.events[n]
    if e and kv_wants(w, e) then out[#out + 1] = e end
  end
  return out
end

local function kv_reply_poll(conn, events, reset)
  local parts = {}
  for i, e in ipairs(events) do parts[i] = kv_event_json(e) end
  json(conn, 200, '{"revision":' .. kv.revision .. ',"events":[' .. table.concat(parts, ',') .. ']'
    .. (reset and ',"reset":true' or '') .. '}')
end

-- Tell every watcher that wants it of a committed change.
local function kv_notify(e, now)
  for conn, w in pairs(kv.streams) do
    if kv_wants(w, e) then queue.push(replies, {conn = conn, chunk = kv_sse(e)}); w.at = now end
  end
  for conn, w in pairs(kv.polls) do
    if kv_wants(w, e) then kv.polls[conn] = nil; kv_reply_poll(conn, {e}) end
  end
end

-- Expired keys leave as events of their own, so a watcher hears of them.
local function kv_sweep(now)
  if not kv.db or not kv.next_expiry then return end
  local wall = host.time()
  if wall < kv.next_expiry then return end
  local gone = kv.db.query('select topic, key from kv where expires > 0 and expires <= ? '
    .. 'order by expires', wall).rows
  for _, r in ipairs(gone) do
    kv_notify(kv_commit({topic = r[1], key = r[2], op = 'expire'},
                        'delete from kv where topic = ? and key = ?', r[1], r[2]), now)
  end
  local e = kv.db.query('select coalesce(min(expires), 0) from kv where expires > 0').rows[1][1]
  kv.next_expiry = e > 0 and e or nil
end

-- depth: kv requests (doc/DRT-Signalling.md §10)

-- Keys travel percent-encoded or not; both spell the same key.
local function kv_unescape(text)
  return (text:gsub('%%(%x%x)', function(h) return string.char(tonumber(h, 16)) end))
end

-- A key, or with `prefix` set the start of one (which may end mid-segment
-- and may be empty). A `.` or `..` segment is refused: a browser's fetch
-- folds `a/../b` into `b` before it is sent.
local function kv_valid_key(key, prefix)
  if key == '' then return prefix end
  if #key > KV_KEY_MAX or not key:match('^[%w%._~/%-]+$')
    or key:sub(1, 1) == '/' or key:find('//', 1, true) then
    return false
  end
  for segment in key:gmatch('[^/]+') do
    if (segment == '.' or segment == '..') and not prefix then return false end
  end
  return true
end

local function kv_etag(version) return '"' .. version .. '"' end

-- If-Match / If-None-Match against the current row (nil when absent):
-- true when the write may go ahead, else false after replying 412.
local function kv_precondition(m, row)
  local h = m.headers or {}
  local match, none = h['if-match'], h['if-none-match']
  local current = row and row.version
  local ok = true
  if match then
    if match == '*' then ok = row ~= nil
    else ok = row ~= nil and match:gsub('^W/', '') == kv_etag(row.version) end
  end
  if ok and none == '*' then ok = row == nil end
  if ok then return true end
  fail(m.conn, 412, row and 'the key is at another version' or 'no such key',
       current and {etag = kv_etag(current)} or nil)
  return false
end

local function kv_get(m, topic, key, wall)
  local row = kv_row(topic, key, wall)
  if not row then return fail(m.conn, 404, 'no such key') end
  queue.push(replies, {conn = m.conn, status = 200, body = row.value,
                       content_type = 'text/plain;charset=utf-8',
                       headers = with({etag = kv_etag(row.version), ['cache-control'] = 'no-cache'})})
end

local function kv_put(m, topic, key, params, now, wall)
  if not utf8.len(m.body) then return fail(m.conn, 400, 'a value is UTF-8 text') end
  if #m.body > KV_VALUE_MAX then return fail(m.conn, 413, 'a value is at most ' .. KV_VALUE_MAX .. ' bytes') end
  local expires = 0
  if params.ttl then
    local ttl = params.ttl:match('^%d+$') and tonumber(params.ttl)
    if not ttl or ttl < 1 or ttl > KV_TTL_MAX then
      return fail(m.conn, 400, 'ttl is whole seconds, 1 to ' .. KV_TTL_MAX)
    end
    expires = wall + ttl * 1000
  end
  local row = kv_row(topic, key, wall)
  if not kv_precondition(m, row) then return end
  local e = kv_commit({topic = topic, key = key, op = 'put', value = m.body},
    'insert into kv (topic, key, value, version, expires) values (?, ?, ?, ?, ?) '
    .. 'on conflict (topic, key) do update set value = excluded.value, version = excluded.version, '
    .. 'expires = excluded.expires', topic, key, m.body, kv.revision + 1, expires)
  if expires > 0 and (not kv.next_expiry or expires < kv.next_expiry) then kv.next_expiry = expires end
  json(m.conn, row and 200 or 201, json_text({key = key, version = e.version}), {etag = kv_etag(e.version)})
  kv_notify(e, now)
end

local function kv_delete(m, topic, key, now, wall)
  local row = kv_row(topic, key, wall)
  if not row and not (m.headers or {})['if-match'] then return fail(m.conn, 404, 'no such key') end
  if not kv_precondition(m, row) then return end
  local e = kv_commit({topic = topic, key = key, op = 'delete'},
                      'delete from kv where topic = ? and key = ?', topic, key)
  json(m.conn, 204, '')
  kv_notify(e, now)
end

local function kv_list(m, topic, params, wall)
  local prefix, after = params.prefix or '', params.after or ''
  if not kv_valid_key(prefix, true) or not kv_valid_key(after, true) then
    return fail(m.conn, 400, 'a malformed prefix or after')
  end
  local limit = KV_LIST_DEFAULT
  if params.limit then
    limit = params.limit:match('^%d+$') and tonumber(params.limit)
    if not limit or limit < 1 or limit > KV_LIST_MAX then
      return fail(m.conn, 400, 'limit is 1 to ' .. KV_LIST_MAX)
    end
  end
  local rows = kv.db.query('select key, value, version, expires from kv where topic = ? '
    .. 'and substr(key, 1, ?) = ? and key > ? and (expires = 0 or expires > ?) order by key limit ?',
    topic, #prefix, prefix, after, wall, limit + 1).rows
  local parts = {}
  for i = 1, math.min(#rows, limit) do
    local r = rows[i]
    local e = {key = r[1], value = r[2], version = r[3]}
    if r[4] > 0 then e.expires_in = math.ceil((r[4] - wall) / 1000) end
    parts[i] = json_text(e)
  end
  json(m.conn, 200, '{"revision":' .. kv.revision .. ',"keys":[' .. table.concat(parts, ',') .. ']'
    .. ',"more":' .. tostring(#rows > limit) .. '}', {['cache-control'] = 'no-cache'})
end

-- `?watch=stream`: an event stream, resumed from Last-Event-ID or `since`.
-- `?watch=poll&since=R[&wait=ms]`: one reply, held until a change after R
-- or for `wait` (at most KV_POLL_MS), for a client that reads no stream
-- (the kv connector).
local function kv_watch(m, topic, params, now)
  local prefix = params.prefix or ''
  if not kv_valid_key(prefix, true) then return fail(m.conn, 400, 'a malformed prefix') end
  local since = params.since or (m.headers or {})['last-event-id']
  if since and not since:match('^%d+$') then return fail(m.conn, 400, 'a malformed since') end
  local w = {topic = topic, prefix = prefix, at = now}
  if params.watch == 'stream' then
    queue.push(replies, {conn = m.conn, stream = true, body = 'retry: 2000\n\n',
                         content_type = 'text/event-stream', headers = with({['cache-control'] = 'no-cache'})})
    kv.streams[m.conn] = w
    if since then
      local missed = kv_since(w, tonumber(since))
      if not missed then
        queue.push(replies, {conn = m.conn, chunk = 'id: ' .. kv.revision .. '\nevent: reset\ndata: {"revision":'
          .. kv.revision .. '}\n\n'})
      else
        for _, e in ipairs(missed) do queue.push(replies, {conn = m.conn, chunk = kv_sse(e)}) end
      end
    end
    return
  end
  if params.watch ~= 'poll' then return fail(m.conn, 400, 'watch is stream or poll') end
  if not since then return fail(m.conn, 400, 'a poll names since, the revision it has') end
  local hold = KV_POLL_MS
  if params.wait then
    hold = params.wait:match('^%d+$') and tonumber(params.wait)
    if not hold or hold > KV_POLL_MS then return fail(m.conn, 400, 'wait is 0 to ' .. KV_POLL_MS .. ' ms') end
  end
  local missed = kv_since(w, tonumber(since))
  if not missed then return kv_reply_poll(m.conn, {}, true) end
  if #missed > 0 then return kv_reply_poll(m.conn, missed) end
  w.ends = now + hold
  kv.polls[m.conn] = w
end

-- `/v1/<topic>/kv` and `/v1/<topic>/kv/<key>`; `rest` is what follows `kv`.
local function kv_route(m, topic, rest, params, now)
  if not kv.db then return fail(m.conn, 404, 'this server keeps no kv; start it with --kv <dir>') end
  if #topic > KV_TOPIC_MAX or not topic:match('^[%w%._~%-]+$') then
    return fail(m.conn, 400, 'a malformed topic')
  end
  local wall = host.time()
  for _, name in ipairs({'prefix', 'after'}) do
    if params[name] then params[name] = kv_unescape(params[name]) end
  end
  rest = kv_unescape(rest)
  if rest == '' or rest == '/' then
    if m.method ~= 'GET' then return fail(m.conn, 405, 'the kv itself is listed or watched, with GET') end
    if not kv_access(m, topic, 'read') then return end
    if params.watch then return kv_watch(m, topic, params, now) end
    return kv_list(m, topic, params, wall)
  end
  local key = rest:sub(2)
  if not kv_valid_key(key) then
    return fail(m.conn, 400, 'a key is 1 to ' .. KV_KEY_MAX .. ' of A-Z a-z 0-9 . _ ~ - and /, with no empty, . or .. segment')
  end
  local op = m.method == 'GET' and 'read' or 'write'
  if m.method == 'GET' then
    if not kv_access(m, topic, op) then return end
    return kv_get(m, topic, key, wall)
  elseif m.method == 'PUT' then
    if not kv_access(m, topic, op) then return end
    return kv_put(m, topic, key, params, now, wall)
  elseif m.method == 'DELETE' then
    if not kv_access(m, topic, op) then return end
    return kv_delete(m, topic, key, now, wall)
  end
  fail(m.conn, 405, 'a key takes GET, PUT or DELETE')
end

local function kv_housekeep(now)
  if not kv.db then return end
  kv_sweep(now)
  for conn, w in pairs(kv.polls) do
    if now >= w.ends then kv.polls[conn] = nil; kv_reply_poll(conn, {}) end
  end
  for conn, w in pairs(kv.streams) do
    if now - w.at >= KEEPALIVE_MS then queue.push(replies, {conn = conn, chunk = ': keepalive\n\n'}); w.at = now end
  end
end

-- depth: the five requests of §2

local routes = {
  {'POST',   '^/v1/([^/]+)/calls$',                'caller'},
  {'GET',    '^/v1/([^/]+)/calls$',                'answerer'},
  {'POST',   '^/v1/([^/]+)/calls/([^/]+)/answer$', 'answerer'},
  {'DELETE', '^/v1/([^/]+)/calls/([^/]+)$',        'either'},
  {'GET',    '^/v1/([^/]+)/events$',               'answerer'},
  {'POST',   '^/v1/([^/]+)/pair$',                 'answerer'},
  {'POST',   '^/v1/([^/]+)/pair/([^/]+)/result$',  'answerer'},
}

local function route(m, now)
  local path, params = split(m.path)
  if m.method == 'OPTIONS' then return json(m.conn, 204, '') end
  local kv_topic, kv_rest = path:match('^/v1/([^/]+)/kv(.*)$')
  if kv_topic and (kv_rest == '' or kv_rest:sub(1, 1) == '/') then
    -- A kv failure (a full disk, a locked file) is this request's 500,
    -- never the end of the signalling server.
    local ok, err = pcall(kv_route, m, kv_topic, kv_rest, params, now)
    if not ok then
      print('p2p match: kv: ' .. tostring(err))
      return fail(m.conn, 500, 'the kv store failed; the server log says why')
    end
    return
  end
  for i, rt in ipairs(routes) do
    local method, pattern, who = table.unpack(rt)
    local name, id = path:match(pattern)
    if m.method == method and name then
      local token = token_of(m, params)
      if i == 1 then return call(m, name, token, now) end
      if not token then return fail(m.conn, 401, 'an answerer token is needed') end
      local r = names[name]
      if who == 'either' and r and r.caller == token then return withdraw(m, r, id) end
      r = claim(m, name, token, now)
      if not r then return end
      if i == 2 then return list(m, r, params, now) end
      if i == 3 then return answer(m, r, id, '/v1/' .. name .. '/calls/') end
      if i == 4 then return withdraw(m, r, id) end
      if i == 6 then return ask_pair(m, r, name, now) end
      if i == 7 then m.name = name; return pair_result(m, r, id, now) end
      return events(m, r, now)
    end
  end
  fail(m.conn, 404, 'no such request')
end

local function closed(conn)
  for _, r in pairs(names) do r.streams[conn] = nil end
  kv.streams[conn] = nil; kv.polls[conn] = nil
end

local function housekeep(now)
  for name, r in pairs(names) do
    for n, c in pairs(r.calls) do
      if now >= c.ends then
        if not c.answered then fail(c.conn, 504, 'no answer within the hold time') end
        r.calls[n] = nil
      end
    end
    for n, p in pairs(r.pairs) do
      if now >= p.ends then r.pairs[n] = nil end
    end
    for conn, at in pairs(r.streams) do
      if now - at >= KEEPALIVE_MS then queue.push(replies, {conn = conn, chunk = ': keepalive\n\n'}); r.streams[conn] = now end
    end
    if not present(r, now) and next(r.calls) == nil and next(r.pairs) == nil then names[name] = nil end
  end
end

print('p2p match: serving ' .. CAPACITY .. ' name(s) at most; admission is by token, not origin')
if KV_DB then
  kv_open()
  print('p2p match: kv in ' .. KV_DB .. ' at revision ' .. kv.revision
    .. '; kv takes no token yet, so whoever reaches this port may read and write it')
end
while true do
  local _, m = queue.wait({requests}, 1000)
  local now = host.monotonic()
  if m and m.event == 'closed' then closed(m.conn)
  elseif m then route(m, now) end
  housekeep(now)
  local ok, err = pcall(kv_housekeep, now)
  if not ok then print('p2p match: kv: ' .. tostring(err)) end
end
