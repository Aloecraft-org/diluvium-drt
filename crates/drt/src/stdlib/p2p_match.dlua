-- `drt p2p --match`: the reference signalling server for
-- doc/DRT-Signalling.md (doc/P2P.md §2.4), grown from
-- examples/30-signaling-room with what the example leaves out: names
-- claimed on first use, a caller token and an admission range set by the
-- answerer when it claims, and a cap on names held at once. The example
-- stays its readable core; this is the whole server.
--
-- ## surface block
--
-- - Entry point: the verb runs it with an http listener on --host:<port>,
--   `args.capacity` the names held at once.
-- - Configurable: HOLD_MS (§3), PRESENT_MS (§4.2), WAITING_CAP (§6),
--   RECORD_MAX (§1), KEEPALIVE_MS (§5), the CORS headers.
-- - Fan-out: `routes`, the five requests of §2 and the two of §6.2
--   (pairing), each with whose token it takes; `claim`, how a name is held.
--
-- Admission is by token, not origin: every reply carries
-- access-control-allow-origin: *, so a page opened from file:// (Origin:
-- null) reaches a named peer as a page served from anywhere does.

local HOLD_MS      = 25000
local PRESENT_MS   = 30000
local WAITING_CAP  = 16
local RECORD_MAX   = 512
local KEEPALIVE_MS = 25000
local CORS = {
  ['access-control-allow-origin']   = '*',
  ['access-control-allow-methods']  = 'GET, POST, DELETE, OPTIONS',
  ['access-control-allow-headers']  = 'authorization, content-type, last-event-id, drt-accept, drt-caller-token',
  ['access-control-expose-headers'] = 'location, retry-after',
}

local requests = queue.declare('http_in', {capacity = 64})
local replies  = queue.declare('http_out', {capacity = 128, exported = true})
local _, args  = queue.wait({queue.declare('args', {capacity = 1})})
local CAPACITY = tonumber(args.capacity) or 256

-- depth: replies

local function with(extra)
  local h = {}
  for k, v in pairs(CORS) do h[k] = v end
  for k, v in pairs(extra or {}) do h[k] = v end
  return h
end

-- `json` is the reply; the encoder is Diluvium's `json` module under another name.
local json_text = json.encode
-- A body read as JSON, or nil: a body that is not JSON is not a request.
local function json_body(text)
  if text == '' then return nil end
  local ok, v = pcall(json.decode, text)
  return ok and v or nil
end

local function json(conn, status, body, extra)
  queue.push(replies, {conn = conn, status = status, body = body,
                       content_type = 'application/json', headers = with(extra)})
end

local function fail(conn, status, why, extra) json(conn, status, json_text({error = why}), extra) end

-- '/v1/page/calls?since=3&k=t' -> '/v1/page/calls', {since = '3', k = 't'}
local function split(target)
  local path, query = target:match('^([^?]*)%??(.*)$')
  local params = {}
  for k, v in query:gmatch('([^&=]+)=([^&]*)') do params[k] = v end
  return path, params
end

-- depth: addresses, for DRT-Accept

-- An IPv4 or IPv6 address as a list of 8-bit numbers, or nil.
local function address_bytes(text)
  local a, b, c, d = text:match('^(%d+)%.(%d+)%.(%d+)%.(%d+)$')
  if a then
    local out = {}
    for _, v in ipairs({a, b, c, d}) do
      v = tonumber(v); if v > 255 then return nil end
      out[#out + 1] = v
    end
    return out
  end
  if not text:find(':') then return nil end
  -- IPv6: expand `::`, each group two bytes.
  local head, tail = text:match('^(.-)::(.*)$')
  local groups = {}
  local function take(part, into)
    if part == '' then return true end
    for g in part:gmatch('[^:]+') do
      if not g:match('^%x%x?%x?%x?$') then return false end
      into[#into + 1] = tonumber(g, 16)
    end
    return true
  end
  if head then
    local h, t = {}, {}
    if not take(head, h) or not take(tail, t) then return nil end
    if #h + #t > 7 then return nil end
    for _, g in ipairs(h) do groups[#groups + 1] = g end
    for _ = 1, 8 - #h - #t do groups[#groups + 1] = 0 end
    for _, g in ipairs(t) do groups[#groups + 1] = g end
  else
    if not take(text, groups) or #groups ~= 8 then return nil end
  end
  local out = {}
  for _, g in ipairs(groups) do out[#out + 1] = g // 256; out[#out + 1] = g % 256 end
  return out
end

-- The address half of a listener's `peer` (`ip:port`, `[ip]:port`).
local function address_of(peer)
  if not peer then return nil end
  local v6 = peer:match('^%[(.-)%]:%d+$')
  if v6 then return v6 end
  local v4 = peer:match('^([%d%.]+):%d+$')
  return v4 or peer
end

-- Whether `ip` is inside one of the ranges in a DRT-Accept value,
-- `cidr, cidr`; a bare address is a /32 or /128. Unreadable ranges admit
-- nothing, so a typo refuses rather than opens.
local function accepted(ranges, ip)
  local addr = address_bytes(ip)
  if not addr then return false end
  for range in ranges:gmatch('[^,%s]+') do
    local net, bits = range:match('^(.-)/(%d+)$')
    if not net then net, bits = range, #addr * 8 end
    local base = address_bytes(net)
    bits = tonumber(bits)
    if base and #base == #addr and bits <= #addr * 8 then
      local ok, left = true, bits
      for i = 1, #addr do
        if left <= 0 then break end
        local keep = left >= 8 and 8 or left
        local shift = 2 ^ (8 - keep)
        if addr[i] // shift ~= base[i] // shift then ok = false; break end
        left = left - 8
      end
      if ok then return true end
    end
  end
  return false
end

local function token_of(m, params)
  local bearer = m.headers and m.headers.authorization
    and m.headers.authorization:match('^Bearer%s+(%S+)$')
  return bearer or params.k
end

-- depth: names, claimed on first use

local names = {}   -- name -> {token, caller, accept, polled, streams, calls, last}
local function held_count()
  local n = 0
  for _ in pairs(names) do n = n + 1 end
  return n
end

local function present(r, now)
  return (r.polled and now - r.polled < PRESENT_MS) or next(r.streams) ~= nil
end

-- The answerer's claim: a free name is taken by the first answerer token to
-- poll it, held while that token is present, and shared by every holder of
-- the same token. A name past the cap is 429; another token's name is 403.
-- Returns the name's record, or nil after replying.
local function claim(m, name, token, now)
  local r = names[name]
  if r and not present(r, now) then names[name] = nil; r = nil end
  if r and r.token ~= token then fail(m.conn, 403, 'this name is held by another answerer'); return nil end
  if not r then
    if held_count() >= CAPACITY then
      fail(m.conn, 429, 'no room for another name', {['retry-after'] = '30'}); return nil
    end
    r = {token = token, streams = {}, calls = {}, pairs = {}, last = 0}
    names[name] = r
  end
  local h = m.headers or {}
  if h['drt-caller-token'] then r.caller = h['drt-caller-token'] end
  if h['drt-accept'] then r.accept = h['drt-accept'] end
  return r
end

-- depth: the room, one per name

local function waiting(r)
  local count = 0
  for _, c in pairs(r.calls) do if not c.answered then count = count + 1 end end
  return count
end

local function checked(m)
  if not utf8.len(m.body) then fail(m.conn, 400, 'a record is text'); return false end
  if #m.body > RECORD_MAX then fail(m.conn, 413, 'a record is at most 512 bytes'); return false end
  return true
end

local function find(r, id)
  local n = tonumber(id:match('^c(%d+)$') or '')
  return n, n and r.calls[n]
end

local function event(cursor, kind)
  return 'id: ' .. cursor .. '\nevent: ' .. (kind or 'call') .. '\ndata: {"cursor":"' .. cursor .. '"}\n\n'
end

local function notify(r, cursor, now, kind)
  for conn in pairs(r.streams) do
    queue.push(replies, {conn = conn, chunk = event(cursor, kind)}); r.streams[conn] = now
  end
end

-- The caller's one request (§3): held until answered, or refused now.
local function call(m, name, token, now)
  local r = names[name]
  if not r or not present(r, now) then return fail(m.conn, 503, 'no answerer is present') end
  if r.caller and token ~= r.caller then
    return fail(m.conn, token and 403 or 401, token and 'this token may not call' or 'this name takes a caller token')
  end
  -- The answerer's DRT-Accept (§6.1): a caller outside it is refused here,
  -- by the address the listener saw, as the parked side refuses its
  -- packets; a server that cannot see addresses leaves that to the peer.
  if r.accept and m.peer and not accepted(r.accept, address_of(m.peer)) then
    return fail(m.conn, 403, 'this address may not call')
  end
  if not checked(m) then return end
  if waiting(r) >= WAITING_CAP then return fail(m.conn, 429, 'too many calls waiting', {['retry-after'] = '5'}) end
  r.last = r.last + 1
  r.calls[r.last] = {record = m.body, conn = m.conn, ends = now + HOLD_MS}
  notify(r, r.last, now)
end

local function list(m, r, params, now)
  local since = params.since or '0'
  if not since:match('^%d+$') then return fail(m.conn, 400, 'a malformed cursor') end
  r.polled = now
  local out, pair = {}, {}
  for n = tonumber(since) + 1, r.last do
    local c = r.calls[n]
    if c and not c.answered then
      out[#out + 1] = {id = 'c' .. n, record = c.record, expires_in = math.ceil((c.ends - now) / 1000)}
    end
    local p = r.pairs[n]
    if p and not p.outcome then
      local e = {id = 'p' .. n, name = p.name, expires_in = math.ceil((p.ends - now) / 1000)}
      if p.token then e.token = p.token end
      pair[#pair + 1] = e
    end
  end
  -- An empty table encodes as an object, so an empty list is written out.
  json(m.conn, 200, '{"cursor":"' .. r.last .. '","calls":' .. (#out > 0 and json_text(out) or '[]')
    .. ',"pair":' .. (#pair > 0 and json_text(pair) or '[]') .. '}')
end

local function answer(m, r, id, base)
  local _, c = find(r, id)
  if not c then return fail(m.conn, 404, 'no such call') end
  if c.answered then return fail(m.conn, 409, 'the call was already answered') end
  if not checked(m) then return end
  c.answered = true
  json(c.conn, 200, m.body, {location = base .. id})
  json(m.conn, 204, '')
end

local function withdraw(m, r, id)
  local n, c = find(r, id)
  if not c then return fail(m.conn, 404, 'no such call') end
  if c.answered then return fail(m.conn, 409, 'the call was already answered') end
  fail(c.conn, 410, 'the call was withdrawn or refused')
  r.calls[n] = nil
  json(m.conn, 204, '')
end

-- depth: pairing (§6.2)

-- `POST /v1/<name>/pair {"name": other}`, with <name>'s answerer token: the
-- server tells `other` to call <name>, with <name>'s caller token. `other`
-- must be present. The entry shares the cursor with calls, so a poll by
-- cursor sees it once.
local function ask_pair(m, r, name, now)
  local body = json_body(m.body)
  local other = type(body) == 'table' and body.name
  if type(other) ~= 'string' or other == '' then return fail(m.conn, 400, 'the body names whom to tell: {"name": "…"}') end
  if other == name then return fail(m.conn, 400, 'a name does not call itself') end
  local o = names[other]
  if not o or not present(o, now) then return fail(m.conn, 503, 'no answerer is present under that name') end
  o.last = o.last + 1
  o.pairs[o.last] = {name = name, token = r.caller, ends = now + HOLD_MS, asked_by = name}
  notify(o, o.last, now, 'pair')
  json(m.conn, 202, '{"id":"p' .. o.last .. '"}')
end

-- `POST /v1/<name>/pair/<id>/result`, with <name>'s answerer token.
local function pair_result(m, r, id, now)
  local n = tonumber(id:match('^p(%d+)$') or '')
  local p = n and r.pairs[n]
  if not p or now >= p.ends then return fail(m.conn, 404, 'no such pairing') end
  local body = json_body(m.body)
  local outcome = type(body) == 'table' and body.outcome
  if outcome ~= 'connected' and outcome ~= 'refused' and outcome ~= 'unreachable' and outcome ~= 'declined' then
    return fail(m.conn, 400, 'outcome is connected, refused, unreachable or declined')
  end
  p.outcome = outcome
  print('p2p match: ' .. p.asked_by .. ' asked for a call from ' .. m.name .. ': ' .. outcome
    .. ((type(body.why) == 'string' and body.why ~= '') and (' (' .. body.why .. ')') or ''))
  json(m.conn, 204, '')
end

local function events(m, r, now)
  queue.push(replies, {conn = m.conn, stream = true, body = 'retry: 2000\n\n',
                       content_type = 'text/event-stream', headers = with({['cache-control'] = 'no-cache'})})
  r.streams[m.conn] = now
  local seen = tonumber((m.headers or {})['last-event-id'] or '')
  if seen and seen < r.last then queue.push(replies, {conn = m.conn, chunk = event(r.last)}) end
end

-- depth: the five requests of §2

local routes = {
  {'POST',   '^/v1/([^/]+)/calls$',                'caller'},
  {'GET',    '^/v1/([^/]+)/calls$',                'answerer'},
  {'POST',   '^/v1/([^/]+)/calls/([^/]+)/answer$', 'answerer'},
  {'DELETE', '^/v1/([^/]+)/calls/([^/]+)$',        'either'},
  {'GET',    '^/v1/([^/]+)/events$',               'answerer'},
  {'POST',   '^/v1/([^/]+)/pair$',                 'answerer'},
  {'POST',   '^/v1/([^/]+)/pair/([^/]+)/result$',  'answerer'},
}

local function route(m, now)
  local path, params = split(m.path)
  if m.method == 'OPTIONS' then return json(m.conn, 204, '') end
  for i, rt in ipairs(routes) do
    local method, pattern, who = table.unpack(rt)
    local name, id = path:match(pattern)
    if m.method == method and name then
      local token = token_of(m, params)
      if i == 1 then return call(m, name, token, now) end
      if not token then return fail(m.conn, 401, 'an answerer token is needed') end
      local r = names[name]
      if who == 'either' and r and r.caller == token then return withdraw(m, r, id) end
      r = claim(m, name, token, now)
      if not r then return end
      if i == 2 then return list(m, r, params, now) end
      if i == 3 then return answer(m, r, id, '/v1/' .. name .. '/calls/') end
      if i == 4 then return withdraw(m, r, id) end
      if i == 6 then return ask_pair(m, r, name, now) end
      if i == 7 then m.name = name; return pair_result(m, r, id, now) end
      return events(m, r, now)
    end
  end
  fail(m.conn, 404, 'no such request')
end

local function closed(conn)
  for _, r in pairs(names) do r.streams[conn] = nil end
end

local function housekeep(now)
  for name, r in pairs(names) do
    for n, c in pairs(r.calls) do
      if now >= c.ends then
        if not c.answered then fail(c.conn, 504, 'no answer within the hold time') end
        r.calls[n] = nil
      end
    end
    for n, p in pairs(r.pairs) do
      if now >= p.ends then r.pairs[n] = nil end
    end
    for conn, at in pairs(r.streams) do
      if now - at >= KEEPALIVE_MS then queue.push(replies, {conn = conn, chunk = ': keepalive\n\n'}); r.streams[conn] = now end
    end
    if not present(r, now) and next(r.calls) == nil and next(r.pairs) == nil then names[name] = nil end
  end
end

print('p2p match: serving ' .. CAPACITY .. ' name(s) at most; admission is by token, not origin')
while true do
  local _, m = queue.wait({requests}, 1000)
  local now = host.monotonic()
  if m and m.event == 'closed' then closed(m.conn)
  elseif m then route(m, now) end
  housekeep(now)
end
