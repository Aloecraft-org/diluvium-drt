{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "owner-paths" },
          { "context": "guarantees" },
          { "context": "canonical-json" },
          { "context": "features (slim)" },
          { "context": "features (cli)" },
          { "context": "features (listen)" },
          { "context": "features (runtime)" },
          { "context": "features (connector-time)" },
          { "context": "features (connector-fs)" },
          { "context": "features (connector-sql)" },
          { "context": "features (connector-crypto)" },
          { "context": "features (connector-rest)" },
          { "context": "features (connector-ssmtp)" },
          { "context": "features (connector-ssh)" },
          { "context": "features (sshd)" },
          { "context": "features (connector-exec)" },
          { "context": "features (connector-socket)" },
          { "context": "features (connector-ws)" },
          { "context": "features (connector-data)" },
          { "context": "features (tunnel)" },
          { "context": "features (relay)" },
          { "context": "features (stun)" },
          { "context": "features (netcheck)" },
          { "context": "features (numeric)" },
          { "context": "features (turn)" },
          { "context": "features (turn-client)" },
          { "context": "features (webrtc)" },
          { "context": "test" },
          { "context": "changelog" },
          { "context": "browser" },
          { "context": "browser-access-client" },
          { "context": "ssh-page" },
          { "context": "wasip2" },
          { "context": "windows" },
          { "context": "fidelity" }
        ]
      }
    }
  ],
  "bypass_actors": [
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }
  ]
}
