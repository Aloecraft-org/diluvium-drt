-- Three workers that count forever; the root prints what happens to them.
local worker = [[
  local n = 0
  while true do
    for i = 1, 2000 do n = n + i end
    queue.wait({queue.lookup('inbox')}, 300)
  end
]]

for _ = 1, 3 do
  local w = host.spawn{code = worker, caps = {'lifecycle'}, budget = {instructions = 100000000}}
  print('spawned worker ' .. w.id)
end

while true do
  local ev = host.events(60000)
  if ev then print('event: ' .. ev.event .. ' ' .. ev.id) end
end
