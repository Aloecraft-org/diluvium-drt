-- The smallest complete drt app: this file, and nothing else.
--
--   drt run app.dlua

print("A single .dlua file is a drt app. This one is running, with no config.")
print("")

-- The clock is a capability, not arithmetic. A connector answers it, so the
-- moment lands in the log and a replay replays it instead of the replayer's.
-- Both calls below are the direct form, which raises on a non-ok reply: the
-- right shape where a refusal really would be a bug.
-- example: omits error handling, because a raise here would mean a bug
print("answered, with no config at all:")
print(string.format("  %-16s %s", "time", host.time()))
print(string.format("  %-16s %s", "time/monotonic", host.monotonic()))
print("")

-- host.try is host.call without the raise: it hands back the reply's status
-- instead of turning a non-ok one into an error. Value first, three values:
-- value, status, detail. Reach for it wherever "no" is an answer, not a bug.
-- example: omits the ok branch, because every call show makes is refused
local function show(name, args)
    local _, status, detail = host.try(name, args)
    print(string.format("  %-16s %-7s %s", name, status, detail))
end

print("denied, because wiring a connector is a config's job:")
show("crypto/random", { n = 16 })
show("fs/read", { path = "app.dlua" })
show("sql/query", { sql = "select 1" })
