-- One program, three apps. A drt app is a config plus a program; here the
-- program is this same file all three times and only the numbers around it
-- change:
--
--   drt run app.dlua                 -- no config, so no bound is stated
--   drt run --config bounded.json    -- a bound this job fits inside
--   drt run --config tight.json      -- a bound it does not
--
-- Nothing below asks what its budget is, and nothing branches on how much is
-- left. A program does not negotiate a budget: it spends, and the VM stops it
-- when the number the config named runs out.

-- example: omits every hostcall. `instructions` counts what the guest VM
-- executes, so a program parked on a slow rest/get spends almost none of this
-- budget; a pure loop is the only honest way to show one run out.
local STEPS = 400000

local acc = 0
for i = 1, STEPS do
    acc = (acc * 31 + i) % 1000003

    -- Progress, so the run that exceeds its bound shows how far it got. The
    -- arithmetic is the same every run, so it gets exactly that far.
    if i % 100000 == 0 then
        print(string.format("  %7d steps   acc = %d", i, acc))
    end
end

print(string.format("finished all %d steps, acc = %d", STEPS, acc))
