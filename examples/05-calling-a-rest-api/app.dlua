-- Outbound HTTP. `allowlist.json` wires the rest connector to exactly one
-- origin; this file names URLs and never says which one was granted.
--
--   drt run --config allowlist.json
--
-- Every call below is refused. The point is the five ways of being refused —
-- each a URL a human skimming a log line would read as the granted API.

-- host.try hands back value, status, detail, so a refusal arrives as a reply
-- to print rather than an error to catch.
-- example: omits the ok branch — nothing here is permitted, so the value is
-- always nil; the `-live` example next door is the one that reads a reply
local function get(url)
    local _, status, detail = host.try("rest/get", { url = url })
    print(string.format("  %-40s %-6s %s", url, status, detail))
end

-- An origin is scheme + host + port, all three. http and https to the same
-- name are two different places, and so is another port.
get("http://api.github.com/zen")
get("https://api.github.com:8443/zen")

-- A name that merely ends with the granted one is a different name.
get("https://api.github.com.example.net/zen")

-- Everything left of the `@` is not the host: this one goes to evil.example.
-- Refused by name, rather than quietly dropped.
get("https://api.github.com@evil.example/zen")

-- The cloud metadata endpoint — the reason an unscoped outbound grant is not
-- a small thing to hand out. Refused before any address is looked up.
get("http://169.254.169.254/latest/meta-data/")
