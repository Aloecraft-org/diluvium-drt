-- Diluvium is Lua 5.5 plus a few additions. Each one below is run.
--
--   drt run app.dlua
--
-- example: omits a config. A lone .dlua file is a whole app; with no config
-- drt wires the time connector, and nothing else.

-- The printer, written in the first addition so it demonstrates itself: `$`
-- before the quote makes `{...}` an expression slot, `::` formats it.
local function row(syntax, result)
    print($"  {syntax::%-31s}{result}")
end

-- Backward compatible is a claim about the syntax, not about the library. os,
-- io and package are ambient authority, so `drt run` seals them; what they did
-- goes through `host.*`, where it costs a grant.
print("what drt seals")
row([[type(require)]],           type(require))
row([[type(os)]],                type(os))
row([[("still Lua"):upper()]],   ("still Lua"):upper())

-- `??` tests for nil where `or` tests for falsiness: `false ?? 8080` keeps the
-- false you were handed.
print("\ninterpolation, and ?? for nil")
local user, ratio = "ana", 2 / 3
row([[$"hi {user}"]],            $"hi {user}")
row([[$"{ratio::%.2f}"]],        $"{ratio::%.2f}")
row([[false ?? 8080]],           false ?? 8080)
row([[false or 8080]],           false or 8080)

-- `?.` skips the rest of the chain once something is nil, the calls in it
-- included. Like `??` it tests for nil, so `false?.x` still raises.
print("\nsafe navigation, and switch")
local cfg = { port = 9000 }
row([[cfg?.port]],               cfg?.port)
row([[cfg?.logging?.level ?? "info"]], cfg?.logging?.level ?? "info")

-- The subject is evaluated once, a case may list several values, and there is
-- no fallthrough. `switch` is a contextual keyword, so its subject may not
-- start with `(`: write `switch code do`, as you would `if code then`.
switch 302 do
    case 200, 204 then row([[switch 302]], "case 200, 204")
    case 301, 302 then row([[switch 302]], "case 301, 302")
    default            row([[switch 302]], "default")
end

-- `defer` runs when the block ends, however it ends: return, break, goto or a
-- raise. Deferred statements run in reverse order.
-- example: omits `with`, `??=` and the compound assignments (`+=`, `..=`).
print("\ndefer")
do
    defer row("", "released (registered first, runs last)")
    defer row("", "closed")
    row([[inside a do block]],   "working")
end

-- The hour everyone spends. `time` is loaded, so you find it, and `time.now()`
-- fails as though the library were missing a function. It is not: `time` is
-- the pure calendar, and the clock is `host.time()`, a capability.
-- example: omits the reply-status check. `host.time()` raises if the time
-- connector is not wired; `host.try("time")` hands back the refusal instead.
print("\nthe clock is not in `time`")
local _, err = pcall(function() return time.now() end)
row([[time.now()]],              $"raises: {err}")
row([[host.time()]],             $"a {type(host.time())}, milliseconds")

-- Units are the other half: `host.time()` answers in milliseconds, every `time`
-- function speaks seconds, so divide at the boundary. Literals stand in for the
-- clock below, so this program prints the same thing twice.
row([[time.iso(1786554000)]],    time.iso(1786554000))
row([[time.iso(1786554000000)]], time.iso(1786554000000))
