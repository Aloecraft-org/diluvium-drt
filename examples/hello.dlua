local calls = queue.declare("host/calls", { capacity = 8, exported = true, on_full = "reject" })
local replies = queue.declare("host/replies", { capacity = 8 })

queue.push(calls, { tok = 7, call = "time" })
local _, reply = queue.wait({replies})
assert(reply.tok == 7, "token echoed verbatim")
assert(reply.status == "ok", tostring(reply.status) .. ": " .. tostring(reply.detail))
print("wall clock ms: " .. tostring(reply.value))

queue.push(calls, { tok = 8, call = "fs/read", args = { path = "x" } })
local _, denied = queue.wait({replies})
assert(denied.status == "denied", "unwired family answers denied")
print("fs/read: " .. denied.status .. " (" .. denied.detail .. ")")
