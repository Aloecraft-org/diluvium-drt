-- The four fs verbs against one granted directory, and what a scope
-- constrains. One program, two apps; this file is the same bytes in both,
-- so every difference between the two outputs is the deployment's:
--
--   drt run --config readwrite.json
--   drt run --config read-only.json

-- host.try is host.call without the raise: value, status, detail.
-- A refusal is a reply, not an exception.
-- example: omits the ok/refused branch — an ok reply carries the value and a
-- refusal carries the sentence, so one line prints whichever came back
local function row(label, value, status, detail)
    print(string.format("  %-24s %-7s %s", label, status, detail or value or "-"))
end

-- host.fs spells out read and write; list and remove are called by name.
local function list()
    local names, status, detail = host.try("fs/list", { path = "." })
    row("fs/list .", names and table.concat(names, "  "), status, detail)
end

print("the four verbs, against the directory the config granted:")

-- The config named ./workspace and no file in it; this program does the
-- reverse, and they meet at the connector.
row("fs/write scratch.txt", host.fs.try_write("scratch.txt", "gone by the end of the run"))
list()
row("fs/read note.txt", host.fs.try_read("note.txt"))
row("fs/remove scratch.txt", host.try("fs/remove", { path = "scratch.txt" }))
list()

print("")
print("what the scope refuses, and in whose words:")

-- max_bytes is checked before the write, so big.txt is never created.
row("fs/write big.txt", host.fs.try_write("big.txt", string.rep("x", 4096)))

-- The grant is the workspace, not the directory the program lives in.
row("fs/read ../app.dlua", host.fs.try_read("../app.dlua"))

-- Refused on the path as typed, before the filesystem is touched at all.
row("fs/read /etc/hosts", host.fs.try_read("/etc/hosts"))
