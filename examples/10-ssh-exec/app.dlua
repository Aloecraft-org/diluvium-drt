-- Two commands this program would like run. Neither line says where.
--
--   drt run --config deploy.json
--   drt run app.dlua

-- example: omits the ok/refused branch — host.try answers value, status,
-- detail, so one line prints whichever of the two came back.
local function show(label, value, status, detail)
    print(string.format("  %-9s %-7s %s", label, status, detail or value))
end

-- The command is the application's. The host, the user and the key are the
-- deployment's, and nothing in this file can name them or reach past them.
show("ssh/exec", host.try("ssh/exec", { command = "uptime" }))

-- Local exec is its own connector, unwired here; 16-exec is the app that
-- wires it, and the scope there names which programs, for how long.
show("exec/run", host.try("exec/run", { argv = { "uptime" } }))
