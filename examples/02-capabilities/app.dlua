-- One program, two apps.
--
-- Run it both ways and compare:
--
--   drt run app.dlua
--   drt run --config with-fs.json
--
-- The bytes of this file are the same in both runs. What differs is what the
-- host wired, and this program learns that as an ordinary reply.

-- host.try is host.call without the raise: it hands back the reply's status
-- instead of turning a non-ok one into an error. Value first, three values:
-- value, status, detail. Reach for it wherever "no" is an answer, not a bug.
-- example: omits the ok/refused branch, because an ok reply carries the value
-- and a refusal carries the sentence, so one line prints whichever came back
local function show(label, value, status, detail)
    print(string.format("  %-25s %-7s %s", label, status, detail or value))
end

-- The config named a directory; this program names a file inside it. Neither
-- half carries the other's: nothing here says `workspace`.
show("fs/read note.txt", host.fs.try_read("note.txt"))

-- The same call, aimed out of that directory. Note the status under the
-- config: `error`, not `denied`. The call did reach the fs connector, which
-- refused it against its own scope.
show("fs/read ../../etc/passwd", host.fs.try_read("../../etc/passwd"))

-- A family neither app wires. Answered, not dropped: every request gets a
-- reply, and `denied` is an ordinary one.
show("sql/query", host.try("sql/query", { sql = "select 1" }))
